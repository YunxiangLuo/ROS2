{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ROS2: Debug hello_ros2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/hello_ros2/hello_node.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/install/lib/python3.10/site-packages"
            },
            "console": "integratedTerminal"
        }
    ]
}
